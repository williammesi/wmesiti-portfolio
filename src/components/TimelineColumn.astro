---
import { Icon } from "astro-icon/components";
import { PortableText } from "astro-portabletext";
import { formatDuration, formatMonthYear, t, type SiteLanguage } from "@/lib/i18n";
import type { TimelineEntry } from "@/types/sanity";

interface Props {
    lang: SiteLanguage;
    title: string;
    icon: string;
    entries: TimelineEntry[];
    emptyLabel: string;
}

const { lang, title, icon, entries, emptyLabel } = Astro.props;
const copy = t(lang).experience;
const headingId = `timeline-${icon.replace(/\W+/g, "-")}`;
---

<section class="flex flex-col gap-6 min-w-0" aria-labelledby={headingId}>
    <header class="flex items-center gap-3">
        <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-mochasurface border border-mochaborder">
            <Icon name={icon} class="w-5 h-5 text-indigo-400" aria-hidden="true" />
        </span>
        <h3 id={headingId} class="text-lg font-semibold text-mochawhite">{title}</h3>
    </header>

    {entries.length > 0 ? (
        <ol class="relative ml-[1.1rem] border-l border-mochaborder">
            {entries.map((entry) => (
                <li class="relative pl-7 pb-10 last:pb-0">
                    <span
                        class:list={[
                            "absolute -left-[6px] top-1.5 w-[11px] h-[11px] rounded-full border-2 border-mochablack",
                            entry.current ? "bg-indigo-400 ring-4 ring-indigo-400/20" : "bg-mochawhite/40",
                        ]}
                        aria-hidden="true"
                    ></span>

                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-mono text-mochawhite/50">
                        <time datetime={entry.startDate}>{formatMonthYear(entry.startDate, lang)}</time>
                        <span aria-hidden="true">—</span>
                        {entry.current || !entry.endDate ? (
                            <span>{copy.present}</span>
                        ) : (
                            <time datetime={entry.endDate}>{formatMonthYear(entry.endDate, lang)}</time>
                        )}
                        <span aria-hidden="true">·</span>
                        {entry.current ? (
                            <span class="text-indigo-300">{copy.ongoing}</span>
                        ) : (
                            <span>{formatDuration(entry.startDate, entry.endDate, lang)}</span>
                        )}
                    </p>

                    <h4 class:list={[
                        "mt-2 text-base md:text-lg font-semibold leading-snug",
                        entry.current ? "text-indigo-300" : "text-mochawhite",
                    ]}>
                        {entry.title}
                    </h4>

                    <div class="mt-1 flex items-center gap-2 text-sm text-mochawhite/80">
                        {entry.logoUrl && (
                            <img
                                src={`${entry.logoUrl}?w=64&h=64&fit=crop&auto=format`}
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy"
                                class="w-5 h-5 rounded object-cover"
                            />
                        )}
                        <span>{entry.organization}</span>
                    </div>

                    {entry.description && entry.description.length > 0 && (
                        <div class="timeline-description mt-3 text-sm text-mochawhite/70 leading-relaxed">
                            <PortableText value={entry.description} />
                        </div>
                    )}

                    {entry.skills && entry.skills.length > 0 && (
                        <ul class="mt-3 flex flex-wrap gap-1.5">
                            {entry.skills.map((skill) => (
                                <li class="px-2 py-0.5 border border-mochaborder rounded-md text-xs text-mochawhite/80">
                                    {skill}
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))}
        </ol>
    ) : (
        <p class="text-sm text-mochawhite/50 pl-12">{emptyLabel}</p>
    )}
</section>

<style>
    .timeline-description :global(p + p) {
        margin-top: 0.5rem;
    }

    .timeline-description :global(ul),
    .timeline-description :global(ol) {
        margin-top: 0.5rem;
        padding-left: 1.1rem;
    }

    .timeline-description :global(ul) {
        list-style: disc;
    }

    .timeline-description :global(ol) {
        list-style: decimal;
    }

    .timeline-description :global(li) {
        margin-top: 0.25rem;
    }

    .timeline-description :global(li::marker) {
        color: rgb(129 140 248 / 0.7);
    }

    .timeline-description :global(strong) {
        color: var(--color-mochawhite);
    }
</style>
