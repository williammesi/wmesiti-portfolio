---
import type { SEOProps } from '@/types/sanity';

interface Props extends SEOProps {
  canonical?: string;
}

const {
  title = "William's Portfolio",
  description = "Portfolio de William Mesiti - Développeur Full Stack passionné par les technologies modernes",
  image = "/profile.webp",
  canonical,
  type = "website",
  noindex = false,
  lang = "fr-CA",
  alternates = [],
  publishedAt,
  updatedAt,
  author = "William Mesiti",
  imageAlt = title,
  keywords = [],
  articleSection,
  breadcrumbs = [],
} = Astro.props;

// Site configuration
const siteName = "William Mesiti — Portfolio & Technical Blog";
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://wmesiti-tech.com").replace(/\/$/, "");

// Construct full URLs
const fullImageUrl = new URL(image, `${siteUrl}/`).href;
const fullCanonicalUrl = new URL(canonical || Astro.url.pathname, `${siteUrl}/`).href;
const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const hasArticleImage = type === "article" && Boolean(Astro.props.image);

// Generate structured data
const person = {
  "@type": "Person",
  "@id": personId,
  "name": author,
  "url": `${siteUrl}/#about`,
  "jobTitle": lang === "en" ? "Full-Stack Developer" : "Développeur Full Stack",
  "sameAs": [
    "https://github.com/wmesiti",
    "https://linkedin.com/in/wmesiti"
  ]
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  "name": siteName,
  "alternateName": "wmesiti-tech",
  "description": "Personal portfolio and bilingual technical blog by William Mesiti.",
  "url": siteUrl,
  "inLanguage": ["fr-CA", "en"],
  "author": { "@id": personId },
};

const webPageId = `${fullCanonicalUrl}#webpage`;
const webPage = {
  "@type": "WebPage",
  "@id": webPageId,
  "name": title,
  "description": description,
  "url": fullCanonicalUrl,
  "inLanguage": lang,
  "isPartOf": { "@id": websiteId },
};

const articleEntity = type === "article" ? {
  "@type": "BlogPosting",
  "@id": `${fullCanonicalUrl}#article`,
  "headline": title,
  "description": description,
  "url": fullCanonicalUrl,
  ...(hasArticleImage ? { "image": [fullImageUrl] } : {}),
  "author": { "@id": personId },
  "publisher": { "@id": personId },
  "datePublished": publishedAt,
  "dateModified": updatedAt || publishedAt,
  "inLanguage": lang,
  "mainEntityOfPage": {
    "@id": webPageId,
  },
  "isPartOf": { "@id": websiteId },
  ...(articleSection ? { "articleSection": articleSection } : {}),
  ...(keywords.length ? { "keywords": keywords } : {}),
} : null;

const breadcrumbEntity = breadcrumbs.length ? {
  "@type": "BreadcrumbList",
  "@id": `${fullCanonicalUrl}#breadcrumb`,
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, `${siteUrl}/`).href,
  })),
} : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    website,
    webPage,
    ...(articleEntity ? [articleEntity] : []),
    ...(breadcrumbEntity ? [breadcrumbEntity] : []),
  ],
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonicalUrl} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}

<!-- Robots -->
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === "en" ? "en_US" : "fr_CA"} />
{alternates.filter((alternate) => alternate.lang !== lang && alternate.lang !== "x-default").map((alternate) => (
  <meta property="og:locale:alternate" content={alternate.lang === "en" ? "en_US" : "fr_CA"} />
))}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{type === "article" && <meta property="article:author" content={author} />}
{articleSection && <meta property="article:section" content={articleSection} />}
{keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}

<!-- Twitter -->
<meta name="twitter:card" content={Astro.props.image ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={fullCanonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:creator" content="@wmesiti" />

<!-- Additional Meta Tags -->
<meta name="theme-color" content="#181825" />
<meta name="msapplication-TileColor" content="#181825" />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cdn.sanity.io" />

<!-- DNS Prefetch -->
<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
<link rel="dns-prefetch" href="https://fonts.gstatic.com" />
<link rel="dns-prefetch" href="https://cdn.sanity.io" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Additional SEO optimizations -->
<meta name="format-detection" content="telephone=no" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={`${siteUrl}/rss.xml`} />

<style>
  /* Critical CSS for better perceived performance */
  html {
    font-family: 'Montserrat', system-ui, sans-serif;
    scroll-behavior: smooth;
    scroll-padding-top: 8rem;
  }

  body {
    margin: 0;
    background-color: #181825;
    color: #cdd6f4;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Prevent layout shift */
  * {
    box-sizing: border-box;
  }

  /* Critical loading styles */
  .loading {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .loading.loaded {
    opacity: 1;
    transform: translateY(0);
  }
</style>
