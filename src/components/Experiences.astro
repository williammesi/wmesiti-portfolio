---
import TimelineColumn from "./TimelineColumn.astro";
import { queries, sanityFetch } from "@/lib/sanity";
import { safeAsync } from "@/utils/errorHandling";
import { queryLang, t, type SiteLanguage } from "@/lib/i18n";
import type { TimelineEntry } from "@/types/sanity";

interface Props {
  id?: string;
  lang?: SiteLanguage;
}

const { id, lang = "fr-CA" } = Astro.props;
const copy = t(lang).experience;
const params = { lang: queryLang(lang) };

const [experiences, educations] = await Promise.all([
  safeAsync(() => sanityFetch<TimelineEntry[]>(queries.experiences, params), []),
  safeAsync(() => sanityFetch<TimelineEntry[]>(queries.educations, params), []),
]);
---

<section id={id} class="flex flex-col items-center md:p-8 gap-10">
   <header class="text-center">
      <h2 class="text-xl md:text-2xl font-bold text-mochawhite mb-2">{copy.title}</h2>
      <div class="w-16 h-0.5 bg-indigo-400 mx-auto"></div>
   </header>

   <div class="w-full max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 px-2">
      <TimelineColumn
         lang={lang}
         title={copy.work}
         icon="mdi:briefcase-outline"
         entries={experiences}
         emptyLabel={copy.emptyWork}
      />
      <TimelineColumn
         lang={lang}
         title={copy.education}
         icon="mdi:school-outline"
         entries={educations}
         emptyLabel={copy.emptyEducation}
      />
   </div>
</section>
