---
import { Button } from "@/components/ui/button";
// Import the PDF file
import cvPDF from "/pdf/CV_WILLIAM_MESITI_2025.pdf";
import Profile from "./Profile.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { alternatePath, blogPath, sectionPath, t, type SiteLanguage } from "@/lib/i18n";

interface Props {
    lang?: SiteLanguage;
    alternateHref?: string;
}

const { lang = "fr-CA", alternateHref } = Astro.props;
const copy = t(lang);
const labels = copy.nav;
const blogHref = blogPath(lang);
const toggleHref = alternateHref || alternatePath(Astro.url.pathname, lang);
---

<div
    class="sticky top-0 w-full z-50 py-4 px-4 sm:px-8 border-b border-b-mochaborder bg-mochablack flex flex-row justify-between items-center"
>
    <Profile />

    <div class="flex flex-row items-center gap-2 lg:gap-4">
    <!-- Desktop Navigation -->
    <div class="hidden lg:flex gap-4 flex-row">
        <a href={sectionPath(lang, "about")}>
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >{labels.about}</Button
            >
        </a>
        <a href={sectionPath(lang, "skills")}>
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >{labels.skills}</Button
            >
        </a>
        <a href={sectionPath(lang, "projects")}>
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >{labels.projects}</Button
            >
        </a>
        <a href={sectionPath(lang, "experience")}>
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >{labels.experience}</Button
            >
        </a>
        <a href={blogHref}>
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >Blog</Button
            >
        </a>
        <a
            href={cvPDF}
            download="CV_William_Mesiti_2025.pdf"
            target="_blank"
            rel="noopener noreferrer"
        >
            <Button
                class="bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                >{labels.resume}</Button
            >
        </a>
    </div>

    <LanguageToggle lang={lang} href={toggleHref} label={labels.switchLanguage} />

    <!-- Mobile Hamburger Menu -->
    <button
        id="mobile-menu-button"
        class="lg:hidden flex flex-col gap-1 p-2 z-50 relative"
        aria-label={labels.openMenu}
        aria-controls="mobile-menu"
        aria-expanded="false"
    >
        <div
            class="hamburger-line w-6 h-0.5 bg-mochawhite transition-all duration-300"
        >
        </div>
        <div
            class="hamburger-line w-6 h-0.5 bg-mochawhite transition-all duration-300"
        >
        </div>
        <div
            class="hamburger-line w-6 h-0.5 bg-mochawhite transition-all duration-300"
        >
        </div>
    </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
        id="mobile-menu"
        class="absolute top-full left-0 right-0 bg-mochablack border-b border-mochaborder opacity-0 invisible transform translate-y-2 transition-all duration-300 z-40 lg:hidden"
    >
        <div class="flex flex-col p-4 gap-3">
            <a href={sectionPath(lang, "about")} class="mobile-nav-link">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >{labels.about}</Button
                >
            </a>
            <a href={sectionPath(lang, "skills")} class="mobile-nav-link">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >{labels.skills}</Button
                >
            </a>
            <a href={sectionPath(lang, "experience")} class="mobile-nav-link">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >{labels.experience}</Button
                >
            </a>
            <a href={sectionPath(lang, "projects")} class="mobile-nav-link">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >{labels.projects}</Button
                >
            </a>
            <a href={blogHref} class="mobile-nav-link">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >Blog</Button
                >
            </a>
            <a href={cvPDF} target="_blank" rel="noopener noreferrer">
                <Button
                    class="w-full bg-mochasurface hover:bg-mochasurfacelight/50 border border-mochaborder text-mochawhite cursor-pointer"
                    >{labels.resume}</Button
                >
            </a>
        </div>
    </div>
</div>

<style>
    .mobile-menu-open .hamburger-line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-menu-open .hamburger-line:nth-child(2) {
        opacity: 0;
    }

    .mobile-menu-open .hamburger-line:nth-child(3) {
        transform: rotate(-45deg) translate(7px, -6px);
    }
</style>

<script>
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
    const mobileCvLink = document.querySelector(
        ".mobile-cv-link",
    ) as HTMLAnchorElement;

    function toggleMobileMenu() {
        const isOpen = mobileMenu?.classList.contains("opacity-100");

        if (isOpen) {
            // Close menu
            mobileMenu?.classList.remove(
                "opacity-100",
                "visible",
                "translate-y-0",
            );
            mobileMenu?.classList.add(
                "opacity-0",
                "invisible",
                "translate-y-2",
            );
            mobileMenuButton?.classList.remove("mobile-menu-open");
            mobileMenuButton?.setAttribute("aria-expanded", "false");
        } else {
            // Open menu
            mobileMenu?.classList.remove(
                "opacity-0",
                "invisible",
                "translate-y-2",
            );
            mobileMenu?.classList.add(
                "opacity-100",
                "visible",
                "translate-y-0",
            );
            mobileMenuButton?.classList.add("mobile-menu-open");
            mobileMenuButton?.setAttribute("aria-expanded", "true");
        }
    }

    function closeMobileMenu() {
        mobileMenu?.classList.remove("opacity-100", "visible", "translate-y-0");
        mobileMenu?.classList.add("opacity-0", "invisible", "translate-y-2");
        mobileMenuButton?.classList.remove("mobile-menu-open");
        mobileMenuButton?.setAttribute("aria-expanded", "false");
    }

    // Toggle menu on hamburger button click
    mobileMenuButton?.addEventListener("click", toggleMobileMenu);

    // Close menu when clicking navigation links
    mobileNavLinks.forEach((link) => {
        link.addEventListener("click", () => {
            closeMobileMenu();
        });
    });

    // Close menu on escape key
    document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape") {
            closeMobileMenu();
        }
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as Node;
        const isClickInsideMenu = mobileMenu?.contains(target);
        const isClickOnButton = mobileMenuButton?.contains(target);

        if (!isClickInsideMenu && !isClickOnButton) {
            closeMobileMenu();
        }
    });

    // Handle window resize
    window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) {
            closeMobileMenu();
        }
    });
</script>
