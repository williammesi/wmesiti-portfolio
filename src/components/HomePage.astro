---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/About.astro';
import SkillsTabs from '@/components/SkillsTabs.astro';
import Projects from '@/components/Projects.astro';
import Experiences from '@/components/Experiences.astro';
import { absoluteUrl } from '@/lib/blog';
import { homePath, isEnglish, t, type SiteLanguage } from '@/lib/i18n';

interface Props {
  lang: SiteLanguage;
}

const { lang } = Astro.props;
const copy = t(lang).home;
const otherLang: SiteLanguage = isEnglish(lang) ? "fr-CA" : "en";
---

<Layout
  title={copy.title}
  description={copy.description}
  type="website"
  lang={lang}
  canonical={absoluteUrl(homePath(lang))}
  alternates={[
    { lang: "fr-CA", href: absoluteUrl(homePath("fr-CA")) },
    { lang: "en", href: absoluteUrl(homePath("en")) },
    { lang: "x-default", href: absoluteUrl(homePath("fr-CA")) },
  ]}
  alternateHref={homePath(otherLang)}
>
  <div class="w-full lg:w-9/10 flex flex-col gap-8 mx-auto p-4">
    <About id="about" lang={lang} />
    <SkillsTabs id="skills" lang={lang} />
    <Projects id="projects" lang={lang} />
    <Experiences id="experience" lang={lang} />
  </div>
</Layout>
